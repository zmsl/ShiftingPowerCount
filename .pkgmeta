package-as: ShiftingPowerCount

enable-nolib-creation: no

# Nothing is uploaded by the packager (release.yml passes -d). manual-changelog keeps it from generating one.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

ignore:
    - README.md
    - CHANGELOG.md
    - spec
    - tools
    - scripts
    - .github
    - .luacheckrc
    - .editorconfig
    - Makefile
    - mise.toml
